# Trav's runtime key (Console workspace "trav", spend limit $50).
# Deliberately NOT named ANTHROPIC_API_KEY, so Claude Code never uses it.
TRAV_ANTHROPIC_API_KEY=

# Trav's own spend guard: the model client stops live calls past this estimate.
TRAV_LIVE_BUDGET_USD=45

# Models for Trav's runtime (the product), not for the build agents.
TRAV_MODEL=claude-sonnet-5-5
TRAV_FAST_MODEL=claude-haiku-5-5
TRAV_GRADER_MODEL=claude-opus-5-5

# 1 = deterministic scripted responses, no API calls (tests and CI).
TRAV_OFFLINE=1

# Simulator (`pnpm sim`). Binds 127.0.0.1 only.
# API + SSE + UI port.
TRAV_SIM_PORT=5179
# Who answers as Trav: auto or agent (both run the real runtime; the old scripted responder is retired).
TRAV_SIM_BACKEND=auto
# Standalone Vite UI port (`pnpm --filter @trav/simulator dev:ui` only).
TRAV_SIM_UI_PORT=5180

# iMessage relay (T-169, docs/RELAY.md). Off unless TRAV_CHANNEL=imessage_relay.
# Mock relay unless TRAV_RELAY_LIVE=1, the vendor key(s) AND TRAV_RELAY_LINE are set. Never commit real values.
TRAV_CHANNEL=
# photon (default), sendblue, or bluebubbles (self-hosted, Dean's dogfooding only: docs/DEPLOY_IMESSAGE.md).
TRAV_RELAY_VENDOR=
TRAV_RELAY_LIVE=
TRAV_RELAY_API_KEY=
# Sendblue only: the secret key.
TRAV_RELAY_API_SECRET=
TRAV_RELAY_WEBHOOK_SECRET=
TRAV_RELAY_LINE=
# Local webhook receiver port (binds 127.0.0.1 only).
TRAV_RELAY_PORT=5181
# Optional: names members saved the line's contact under, other than "Trav" (comma-separated), read as @trav.
TRAV_RELAY_CONTACT_NAME=
# BlueBubbles only. The server origin (https, or http://127.0.0.1:<port> on the same Mac); required for live.
# TRAV_RELAY_API_KEY is the server password; TRAV_RELAY_WEBHOOK_SECRET goes in the webhook URL as ?token=,
# so it must be URL-safe (letters, digits, - . _ ~): generate it with `openssl rand -hex 32`.
TRAV_BLUEBUBBLES_URL=
# 1 only if the server's Private API helper is installed (tapbacks and threaded replies out).
TRAV_BLUEBUBBLES_PRIVATE_API=

# --- apps/server (T-188, docs/SERVER.md). Uses TRAV_RELAY_PORT above. ---
# SQLite file; must sit under a .trav/ directory. Default <repo>/.trav/trav.sqlite.
TRAV_SERVER_DB=
# JSON file of provisioned groups (chat id, members' addresses, optional trip).
TRAV_SERVER_GROUPS=
# Scheduler tick in ms (default 30000, minimum 1000).
TRAV_SERVER_TICK_MS=
# Extra accepted Host names (tunnel or platform hostname), comma-separated, no ports.
TRAV_SERVER_PUBLIC_HOSTS=
# Containers only: TRAV_SERVER_DEPLOY=1 with TRAV_SERVER_HOST=0.0.0.0. Otherwise binds 127.0.0.1.
TRAV_SERVER_DEPLOY=
TRAV_SERVER_HOST=
