[
  {
    "id": "silence_and_tapbacks",
    "title": "Trav stays out of chat it was not pulled into; \"thanks trav\" gets a ❤️, not a message",
    "tags": ["budget", "voice", "mention", "regression"],
    "steps": [
      {
        "do": "say",
        "at": "2026-03-14T20:00:00+01:00",
        "from": "h_chase",
        "text": "ok who's coming to razz tonight",
        "expect": { "silent": true }
      },
      { "do": "say", "from": "h_crowley", "text": "me!! henry you in?", "expect": { "silent": true } },
      { "do": "say", "from": "h_henry", "text": "nah i feel like garbage", "expect": { "silent": true } },
      { "do": "say", "from": "h_piotr", "text": "trav booked it already right?", "expect": { "silent": true } },
      { "do": "say", "from": "h_arjun", "text": "travis is coming tomorrow btw", "expect": { "silent": true } },
      {
        "do": "say",
        "from": "h_chase",
        "text": "thanks trav",
        "expect": { "note": "mention:thanks" }
      },
      {
        "do": "say",
        "from": "h_dean",
        "id": "dup",
        "text": "@trav get the 5 of us Razzmatazz tickets, Henry's sick",
        "expect": { "toolCalls": ["propose_booking"] }
      }
    ]
  }
]
